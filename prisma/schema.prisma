// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Movies {
  id     String @id
  title  String 
  genres String
}

model Tags {
  id        Int    @id @default(autoincrement())
  userId    String
  movieId   String 
  tag       String
  timestamp String
  
  @@unique([userId, movieId, tag])
}

model Links {
  movieId String @id
  imdbId  String
  tmdbId  String
}

model Ratings {
  id        Int    @id @default(autoincrement())
  userId    String
  movieId   String
  rating    String
  timestamp String
  
  @@unique([userId, movieId])
}